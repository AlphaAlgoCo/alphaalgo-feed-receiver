# Copy to .env (never commit real signing secrets)
# Map one or more key_ids to your whsec_... signing secrets from the AlphaAlgo
# Developer Feed portal:
ALPHAALGO_RECEIVER_KEYS_JSON={"v1":"whsec_REPLACE_WITH_YOUR_SIGNING_SECRET"}
ALPHAALGO_DB_PATH=./receipts.db
ALPHAALGO_HOST=127.0.0.1
ALPHAALGO_PORT=9091
# Optional: append every verified v3 event to a JSONL file
# ALPHAALGO_JSONL_LOG=./events.jsonl
# Optional: read-only Discord webhook forwarder (HTTPS required)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Optional: read-only Telegram Bot forwarder (set both token and chat ID)
# TELEGRAM_BOT_TOKEN=123456789:AA...
# TELEGRAM_CHAT_ID=-1001234567890
# Optional: run downstream handlers asynchronously on a background worker thread
# ALPHAALGO_ASYNC_HANDLERS=true
