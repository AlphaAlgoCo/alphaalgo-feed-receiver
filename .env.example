# Copy to .env (never commit real signing secrets)
# Map one or more key_ids to your whsec_... signing secrets from the AlphaAlgo
# Developer Feed portal:
ALPHAALGO_RECEIVER_KEYS_JSON={"v1":"whsec_REPLACE_WITH_YOUR_SIGNING_SECRET"}
ALPHAALGO_DB_PATH=./receipts.db
ALPHAALGO_HOST=127.0.0.1
ALPHAALGO_PORT=9091
# Optional: append every verified v3 event to a JSONL file
# ALPHAALGO_JSONL_LOG=./events.jsonl
# Optional: personal, private read-only alerting sinks (for the subscriber's
# own private use only — redistributing or reselling feed data to third parties,
# public channels, or paid groups violates AlphaAlgo's Subscription Terms).
# Discord private webhook (HTTPS required):
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Telegram Bot private DM (set both bot token and your personal numeric chat ID):
# TELEGRAM_BOT_TOKEN=123456789:AA...
# TELEGRAM_CHAT_ID=123456789
# Optional: run downstream handlers asynchronously on a background worker thread
# ALPHAALGO_ASYNC_HANDLERS=true
# Optional: Docker Compose `--profile https` (automatic Let's Encrypt via Caddy)
# Set to a hostname whose DNS A record points to your VPS (no https:// prefix)
# ALPHAALGO_DOMAIN=feed.yourdomain.com
# Optional: Docker Compose `--profile named-tunnel` (Cloudflare Zero Trust)
# CLOUDFLARE_TUNNEL_TOKEN=eyJ...
